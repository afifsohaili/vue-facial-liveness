{
  "name": "vue-facial-liveness",
  "version": "3.6.5",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/style.css"
  },
  "browser": {
    "./styles.css": "./dist/style.css"
  },
  "types": "dist/index.d.ts",
  "sideEffects": [
    "dist/**/*.css"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/afifsohaili/vue-facial-liveness"
  },
  "files": [
    "dist",
    "patches",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "rimraf dist && patch-package",
    "build": "vite build",
    "dev": "vite build --watch",
    "clean": "rimraf dist node_modules",
    "check:esm": "node --input-type=module --eval 'import \"vue-facial-liveness\"'",
    "lint": "yarn typecheck && eslint .",
    "test": "jest",
    "test:watch": "yarn test --watch",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@aws-amplify/ui": "6.15.4",
    "@aws-sdk/client-rekognitionstreaming": "3.967.0",
    "@aws-sdk/util-format-url": "3.965.0",
    "@smithy/eventstream-serde-browser": "^4.0.4",
    "@smithy/fetch-http-handler": "^5.0.4",
    "@smithy/protocol-http": "^3.0.3",
    "@smithy/signature-v4": "5.1.2",
    "@smithy/types": "^4.3.1",
    "@mediapipe/face_detection": "^0.4.1646425229",
    "@tensorflow/tfjs-backend-cpu": "4.11.0",
    "@tensorflow/tfjs-backend-wasm": "4.11.0",
    "@tensorflow/tfjs-converter": "4.11.0",
    "@tensorflow/tfjs-core": "4.11.0",
    "@xstate/vue": "0.8.1",
    "tslib": "^2.5.2",
    "uuid": "^11.1.1",
    "xstate": "^4.33.6"
  },
  "devDependencies": {
    "@tensorflow-models/face-detection": "~1.0.3",
    "@testing-library/vue": "^6.6.0",
    "@types/jest-when": "^3.5.0",
    "@vitejs/plugin-vue-jsx": "^4.1.1",
    "@vue/test-utils": "^2.4.1",
    "@vue/vue3-jest": "^29.2.6",
    "babel-jest": "^29.7.0",
    "blob-polyfill": "^7.0.20220408",
    "jest-canvas-mock": "^2.5.2",
    "jest-websocket-mock": "^2.4.1",
    "jest-when": "^3.5.1",
    "mock-socket": "^9.2.1",
    "patch-package": "~8.0.1",
    "web-streams-polyfill": "^3.2.1"
  },
  "peerDependencies": {
    "@aws-amplify/core": "*",
    "aws-amplify": "^6.15.9",
    "vue": "^3.0"
  }
}
