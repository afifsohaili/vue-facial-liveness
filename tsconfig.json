{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "esModuleInterop": true,
    "importHelpers": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "node",
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2020",
    "types": ["vite/client", "@types/emscripten", "@types/long", "@testing-library/jest-dom"]
  },
  "include": ["*.mjs", "*.ts", "src/**/*.ts", "src/**/*.vue"],
  "exclude": ["node_modules"]
}
